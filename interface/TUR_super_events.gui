guiTypes = {
	containerWindowType = {
		name = "super_event_1"
		position = { x = -64% y = 30% }
		size = { width = 570 height = 600 }
		orientation = upper_right
		
		fade_time = 300
		fade_type = linear
		moveable = yes
		click_to_front = yes
		
		background = {
			name = "2023_background"
			spriteType = "GFX_2023ss"
		}
		
		instantTextBoxType = {
			name = "super_event_1_title"
			position = { x = 65 y = 38 }
			font = "hoi_30header"
			maxWidth = 400
			maxHeight = 20
			text = "SUPEREVENT_1_T"	
			format = centre
		}
		
		instantTextBoxType = {
			name = "super_event_1_desc"
			position = { x = 200 y = 350 }
			font = "hoi_18mbs"
			maxWidth = 370
			maxHeight = 70
			text = "SUPEREVENT_1_DESC"	
			format = centre
		}
		
		buttonType = {
			name = "super_event_1_close_button"
			position = { x = 230 y = 480 }
			spriteType = "GFX_sort_button_140x29"
			frame = 1
			font = "hoi_18mbs"
			text = "Ok"
			format = center
			shortcut = "ESCAPE"
		}
	}
 }

